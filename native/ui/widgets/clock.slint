// Port of src/components/clock/component.svelte: HH:mm (text-9xl) and
// "dddd, D MMMM YYYY" (text-3xl); the web app's seconds are left out so the window is
// not redrawn every second. Positions reproduce the CSS boxes (leading-none,
// -mt-4, items-end, pb-3, gap-3), so the glyphs land where Chromium draws them.
import { Theme, Label } from "../theme.slint";

export global ClockData {
    in property <string> time: "--:--";
    in property <string> date;
}

export component Clock {
    // The CSS box is 112px time row + 12px gap + 36px date line.
    min-height: 160px;
    preferred-height: 160px;
    preferred-width: max(time.preferred-width, date.preferred-width);

    // y offsets put the Roboto baseline (ascent 0.928em) where CSS puts it.
    time := Label {
        x: 0;
        y: -26px;
        text: ClockData.time;
        font-size: Theme.text-9xl;
    }

    date := Label {
        x: 0;
        y: 126px;
        text: ClockData.date;
        font-size: Theme.text-3xl;
        opacity: Theme.dim;
    }
}
