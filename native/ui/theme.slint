// Shared look. Sizes follow the Tailwind classes used by the Svelte components
// (text-xl = 20px, text-5xl = 48px, gap-6 = 24px, ...), so a port can copy them 1:1.

export global Theme {
    out property <color> fg: #f5f5f5;           // text-neutral-100 (dashboard default)
    out property <color> error: #f87171;        // text-red-400
    out property <float> dim: 0.9;              // opacity-90
    out property <length> gap: 24px;            // gap-6 between widgets in one area

    out property <length> text-xs: 12px;
    out property <length> text-sm: 14px;
    out property <length> text-base: 16px;
    out property <length> text-lg: 18px;
    out property <length> text-xl: 20px;
    out property <length> text-2xl: 24px;
    out property <length> text-3xl: 30px;
    out property <length> text-4xl: 36px;
    out property <length> text-5xl: 48px;
    out property <length> text-6xl: 60px;
    out property <length> text-7xl: 72px;      // keep text containing emoji at or below 80px
    out property <length> text-9xl: 128px;
}

// Text in the dashboard colour. The window's default weight is bold (font-bold), as in the web app.
export component Label inherits Text {
    color: Theme.fg;
}
